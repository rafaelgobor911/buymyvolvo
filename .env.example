# -----------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA commite .env / .env.local.
# Na Fase 0 todas são opcionais; cada módulo exige as suas quando for usado
# (ver src/lib/env/schema.ts).
# -----------------------------------------------------------------------------

# --- Site (públicas: vão para o bundle do navegador) -------------------------
# Padrão: Buy My Volvo
NEXT_PUBLIC_SITE_NAME=
# Padrão: http://localhost:3000. Em produção (obrigatório): https://buymyvolvo.com.br
NEXT_PUBLIC_SITE_URL=
# "true" mostra o aviso de dados fictícios e desativa o contato real (previews)
NEXT_PUBLIC_DEMO_MODE=

# --- Google Analytics / Google Ads (públicas; só carregam após o consentimento) ---
# Sem nenhuma delas: sem banner de cookies e sem script do Google.
# GA4: ID de métricas do fluxo da Web (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads (AW-123456789) e o rótulo da conversão "contato" (cada clique no WhatsApp/Instagram).
# Ligar o Google Ads muda a versão do consentimento: todos são perguntados de novo.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Banco de dados ----------------------------------------------------------
# Local: postgresql://postgres:postgres@127.0.0.1:5432/buymyvolvo
# Supabase: URL do pooler (modo transaction, porta 6543)
DATABASE_URL=
# Banco descartável para os testes de integração (npm test). Só local.
TEST_DATABASE_URL=

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor; ignora RLS. Nunca expor no navegador. Usada para guardar as fotos dos
# vendedores no Supabase Storage ("Secret key" sb_secret_… ou a service_role antiga).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (extração de anúncios) ----------------------------------------
# Necessária para npm run extract:eval e para o job process-posts.
# Na nuvem do Claude Code esta variável não chega aos comandos: guarde a chave em
# BUYMYVOLVO_ANTHROPIC_API_KEY e rode ANTHROPIC_API_KEY="$BUYMYVOLVO_ANTHROPIC_API_KEY" ...
ANTHROPIC_API_KEY=
# Padrão: claude-haiku-5-5
ANTHROPIC_MODEL_EXTRACTION=

# --- Meta / Instagram (somente API oficial) ----------------------------------
META_APP_ID=
# Gera o appsecret_proof das chamadas e o token de app do debug_token (job token-health)
META_APP_SECRET=
# Padrão: v27.0 (vigente em nov/2026; conferir o changelog da Graph API)
META_GRAPH_VERSION=
# ID da conta profissional do Instagram que faz as consultas
IG_BUSINESS_USER_ID=
# Token de usuário de longa duração (60 dias) ou System User token. Ver docs/meta-setup.md
IG_LONG_LIVED_TOKEN=

# --- Segurança / operação ----------------------------------------------------
# >= 32 caracteres aleatórios (ex.: openssl rand -hex 32). As rotas /api/cron/<job>
# exigem o header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# E-mails (contas Google) com acesso ao /admin, separados por vírgula
ADMIN_EMAILS=
# SÓ PARA TESTES LOCAIS/CI: login de admin sem Google com este e-mail (precisa estar em
# ADMIN_EMAILS e de NEXT_PUBLIC_DEMO_MODE=true). Nunca defina num ambiente publicado.
ADMIN_TEST_LOGIN_EMAIL=
# SÓ PARA TESTES LOCAIS/CI: login de vendedor sem Google com este e-mail (mesmas travas).
SELLER_TEST_LOGIN_EMAIL=
# >= 32 caracteres aleatórios (ex.: openssl rand -hex 32); obrigatório para o botão do
# WhatsApp (/r): IP e user agent dos cliques só são guardados em HMAC com este salt
HASH_SALT=
