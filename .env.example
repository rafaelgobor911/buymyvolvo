# -----------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA commite .env / .env.local.
# Na Fase 0 todas são opcionais; cada módulo exige as suas quando for usado
# (ver src/lib/env/schema.ts).
# -----------------------------------------------------------------------------

# --- Site (públicas: vão para o bundle do navegador) -------------------------
# Nome provisório. Padrão: [NOME_DO_SITE]
NEXT_PUBLIC_SITE_NAME=
# Padrão: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# "true" mostra o aviso de dados fictícios e desativa o contato real (previews)
NEXT_PUBLIC_DEMO_MODE=

# --- Banco de dados ----------------------------------------------------------
# Local: postgresql://postgres:postgres@127.0.0.1:5432/buymyvolvo
# Supabase: URL do pooler (modo transaction, porta 6543)
DATABASE_URL=
# Banco descartável para os testes de integração (npm test). Só local.
TEST_DATABASE_URL=

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor; ignora RLS. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (extração de anúncios) ----------------------------------------
# Necessária para npm run extract:eval e para o job process-posts.
# Na nuvem do Claude Code esta variável não chega aos comandos: guarde a chave em
# BUYMYVOLVO_ANTHROPIC_API_KEY e rode ANTHROPIC_API_KEY="$BUYMYVOLVO_ANTHROPIC_API_KEY" ...
ANTHROPIC_API_KEY=
# Padrão: claude-haiku-5-5
ANTHROPIC_MODEL_EXTRACTION=

# --- Meta / Instagram (somente API oficial) ----------------------------------
META_APP_ID=
# Gera o appsecret_proof das chamadas e o token de app do debug_token (job token-health)
META_APP_SECRET=
# Padrão: v27.0 (vigente em nov/2026; conferir o changelog da Graph API)
META_GRAPH_VERSION=
# ID da conta profissional do Instagram que faz as consultas
IG_BUSINESS_USER_ID=
# Token de usuário de longa duração (60 dias) ou System User token. Ver docs/meta-setup.md
IG_LONG_LIVED_TOKEN=

# --- Segurança / operação ----------------------------------------------------
# >= 32 caracteres aleatórios (ex.: openssl rand -hex 32). As rotas /api/cron/<job>
# exigem o header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Lista separada por vírgula
ADMIN_EMAILS=
# >= 32 caracteres aleatórios; usado no hash de IP/UA dos leads
HASH_SALT=
